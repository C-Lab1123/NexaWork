DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC
ACCOUNT_INVITATION_TIMEOUT=259200

# Brevo SMTP. Use the SMTP login and SMTP key from Brevo, not an API key.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=NexaWork <favourowoicho208@gmail.com>

# Configure these four values to use PostgreSQL instead of the local SQLite database.
POSTGRES_DB=
POSTGRES_USER=nexawork
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Start the local Redis service with `docker compose up -d redis`.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Local LiveKit values only. Replace with deployment secrets in production.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-change-this-for-local-only
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_INTERNAL_URL=http://localhost:7880

# Optional private S3-compatible storage, e.g. AWS S3.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
